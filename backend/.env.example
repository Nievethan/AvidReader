# Local development environment for the AvidReader backend.
# Copy to .env and adjust as needed. Never commit a real .env file.

APP_ENV=local

# Comma-separated list of allowed CORS origins.
BACKEND_CORS_ORIGINS=http://localhost,http://127.0.0.1,http://10.0.2.2

# SQLite by default -- no external database required to run locally.
DATABASE_URL=sqlite:///./data/avidreader.db
UPLOADS_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=52428800

# Vector store. Blank QDRANT_URL = embedded Qdrant saved under
# QDRANT_LOCAL_PATH (no Docker needed). docker-compose sets
# QDRANT_URL=http://qdrant:6333 for the backend container.
QDRANT_URL=
QDRANT_LOCAL_PATH=./data/qdrant
QDRANT_COLLECTION=avidreader_chunks

# Optional integration (Gitae). Leave blank -- /ready reports "not configured".
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# --- RAG pipeline (Umer) ---
# Cloudflare Workers AI. Credentials come from Gitae; never commit real values.
# Without them the backend still runs: fake embeddings + offline extractive answers.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Chat model for grounded answers (a Workers AI id like @cf/vendor/model).
# Blank or invalid values fall back to the default below.
CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Embedding model + vector size are pinned per Qdrant collection. Changing
# either requires re-ingesting every book.
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CONCURRENCY=4
# auto = Cloudflare if credentials are set, else the offline fallback.
EMBEDDING_BACKEND=auto
ANSWER_BACKEND=auto

# Chunking + retrieval
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_RATIO=0.12
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.5

# Answers
ANSWER_MAX_TOKENS=400
ANSWER_TIMEOUT_SECONDS=20
STORY_MAX_TOKENS=450
STORY_CONTEXT_CHUNKS=3
HISTORY_MAX_MESSAGES=6

# Cleaned page/chapter text for GET /books/{id}/content
EXTRACTED_DIR=./data/extracted
