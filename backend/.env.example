# Local development environment for the AvidReader backend.
# Copy to .env and adjust as needed. Never commit a real .env file.

APP_ENV=local

# Comma-separated list of allowed CORS origins.
BACKEND_CORS_ORIGINS=http://localhost,http://127.0.0.1,http://10.0.2.2

# SQLite by default -- no external database required to run locally.
DATABASE_URL=sqlite:///./data/avidreader.db
UPLOADS_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=52428800

# Optional integrations. Leave blank to run the backend without them --
# /ready reports them as "not configured" rather than failing.
QDRANT_URL=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# --- RAG pipeline (Umer) ---
# Cloudflare Workers AI. Credentials come from Gitae; never commit real values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TEXT_MODEL=
# Embedding model + vector size are pinned per Qdrant collection. Changing
# either requires re-ingesting every book. [Verify IDs/dims in Cloudflare docs]
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CONCURRENCY=4
# auto = Cloudflare if credentials are set, else a deterministic fake (offline dev).
EMBEDDING_BACKEND=auto
QDRANT_COLLECTION=avidreader_chunks
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_RATIO=0.12
